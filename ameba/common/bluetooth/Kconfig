config REALTEK_AMEBA_ZEPHYR_BT
	bool "RealTek Ameba Zephyr BT"
	default n
	select ZEPHYR_MBEDTLS_MODULE
	select SHARED_INTERRUPTS
	help
	  This option enables the Realtek Ameba BT.

if REALTEK_AMEBA_ZEPHYR_BT

config BT
	bool "Enable BT"
	default y

config BT_SMP
	bool
	default y

config BT_SHELL
	bool
	default y

config BT_PERIPHERAL
	bool "Enable BT Peripheral"
	default n

config BT_CENTRAL
	bool "Enable BT Central"
	default n

if BT_CENTRAL
	config BT_GATT_CLIENT
		bool
		default y
endif

config BT_PRIVACY
	bool "Enable BT Privacy"
	default n

config BT_EXT_ADV
	bool "Enable BT Extended Advertising"
	default n

if BT_EXT_ADV
	config BT_EXT_ADV_MAX_ADV_SET
		int "Max Advertising Sets"
		default 2
endif

config COMMON_LIBC_MALLOC_ARENA_SIZE
	default 8192

config BT_BUF_ACL_TX_COUNT
	default 8

config BT_CLASSIC
	bool "Enable BT Classic"
	depends on SOC_SERIES_AMEBASMART
	default n

config BT_A2DP
	bool "Enable BT A2DP"
	depends on BT_CLASSIC
	select LIBSBC
	default n

if BT_A2DP

	config BT_PERIPHERAL
		bool
		default y

	config BT_CENTRAL
		bool
		default y

	config BT_A2DP_SINK
		bool
		default y

	config BT_AVDTP
		bool
		default y

	config BT_A2DP_SOURCE
		bool
		default y

	config USE_CODEC_CLOCK
		bool "I2S BCK is generated by a selected codec device"
		help
		If selected, the I2S selected peripheral will be configured to consume
		(receive) the I2S BCK and WS signals and the codec will be configured
		to generate those. If not selected, the I2S peripheral will generate
		them and the codec will be expected to consume them.

	config A2DP_SBC_PCM_BUFFER_PLAY_COUNT
		int
		default 50

	config A2DP_BOARD_CODEC_PLAY_COUNT
		int
		default 4

	config A2DP_BOARD_CODEC_PLAY_THRESHOLD
		int
		default 20

	config BT_A2DP_SOURCE_DISCOVER_RESULT_COUNT
		int
		default 10

	config BT_A2DP_SOURCE_EPS_DISCOVER_COUNT
		int
		default 5

	config BT_A2DP_SOURCE_SBC_BIT_RATE_DEFAULT
		int
		default 229

	config BT_A2DP_SOURCE_DATA_SEND_INTERVAL
		int
		default 10

	config BT_A2DP_SOURCE_DATA_BUF_SIZE
		int
		default 1000

	config BT_A2DP_SOURCE_DATA_BUF_COUNT
		int
		default 5

	config BT_A2DP_SOURCE_DATA_SEND_WORKQ_STACK_SIZE
		int
		default 1024

	config BT_A2DP_SOURCE_DATA_SEND_WORKQ_PRIORITY
		int
		default SYSTEM_WORKQUEUE_PRIORITY

	config BT_COD
		hex
		default 0x200404

	config BT_BUF_ACL_RX_SIZE
		int
		default 1300
endif


if SETTINGS
	config BT_SETTINGS
		bool
		default y
endif

endif # REALTEK_AMEBA_ZEPHYR_BT
